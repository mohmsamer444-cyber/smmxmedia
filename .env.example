# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SMM Panel Provider Reseller API Credentials (Optional - App provides built-in fallback simulation if empty)
VITE_SMM_API_URL="https://example-smm-provider.com/api/v2"
VITE_SMM_API_KEY="your_api_key_here"

